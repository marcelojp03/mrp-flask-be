# ============================================
# MRP Backend - Environment Variables
# ============================================
# IMPORTANTE: NO COMMITEAR ESTE ARCHIVO CON CREDENCIALES REALES
# Copiar como .env y llenar con tus valores reales

# ============================================
# Base de Datos PostgreSQL
# ============================================
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASS=tu_password_aqui
DB_NAME=mrp

# ============================================
# JWT Authentication
# ============================================
JWT_SECRET_KEY=tu_secreto_jwt_muy_seguro_aqui_cambiar_en_produccion
JWT_ACCESS_TOKEN_EXPIRES=3600
JWT_REFRESH_TOKEN_EXPIRES=604800

# ============================================
# Flask
# ============================================
FLASK_ENV=development
FLASK_DEBUG=True

# ============================================
# OpenAI (Opcional - para reportes AI)
# ============================================
# OPENAI_API_KEY=sk-...tu_api_key_aqui

# ============================================
# AWS (Opcional - para deployment)
# ============================================
# AWS_REGION=us-east-1
# AWS_ACCOUNT_ID=123456789012
# ECR_REPOSITORY=mrp-backend
